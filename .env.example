# Gere com: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=troque-por-uma-chave-aleatoria

ADMIN_USERNAME=admin
# Gere com: python -c "from werkzeug.security import generate_password_hash; print(generate_password_hash('sua-senha'))"
ADMIN_PASSWORD_HASH=cole-o-hash-aqui

DB_HOST=seu-host-mysql
DB_PORT=3306
DB_USER=seu-usuario
DB_PASSWORD=sua-senha-do-banco
DB_NAME=blog_pupo

# Apenas desenvolvimento local. Na Vercel, use armazenamento de objetos.
ENABLE_LOCAL_UPLOADS=true
FLASK_DEBUG=false
